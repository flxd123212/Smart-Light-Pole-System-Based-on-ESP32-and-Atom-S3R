/*\n  智能灯杆 — AtomS3R-M12 摄像头节点 (旧版, 仅供独立测试)\n  ================================================\n  角色: 只负责拍照, 通过串口 UART 把 JPEG 发给 ESP32-S3-WROOM-2 主控\n  主板: AtomS3R-M12 (M12镜头 + OV3660)\n\n  帧协议 (与新版一致):\n    AA 55 [type:1] [len:4 LE] [crc16:2 LE] [JPEG ...] 55 AA 55 AA\n    type=0x01: 流帧 (VGA 640x480)\n    type=0x02: 拍照帧 (UXGA, 保存到图库)\n\n  接线:\n    AtomS3R G1(TX)  →  ESP32-S3 RX\n    AtomS3R G2(RX)  →  ESP32-S3 TX\n    AtomS3R GND     →  ESP32-S3 GND\n    AtomS3R 5V      →  ESP32-S3 5V\n*/\n\n#include <Arduino.h>\n#include \"esp_camera.h\"\n\n// ========== 摄像头引脚定义 ==========\n#define PWDN_GPIO_NUM   -1\n#define RESET_GPIO_NUM  -1\n#define XCLK_GPIO_NUM   21\n#define SIOD_GPIO_NUM   12\n#define SIOC_GPIO_NUM    9\n#define Y9_GPIO_NUM     13\n#define Y8_GPIO_NUM     11\n#define Y7_GPIO_NUM     17\n#define Y6_GPIO_NUM      4\n#define Y5_GPIO_NUM     48\n#define Y4_GPIO_NUM     46\n#define Y3_GPIO_NUM     42\n#define Y2_GPIO_NUM      3\n#define VSYNC_GPIO_NUM  10\n#define HREF_GPIO_NUM   14\n#define PCLK_GPIO_NUM   40\n#define POWER_N          18\n\n// ========== 配置 ==========\n#define SERIAL_BAUD      921600\n#define SHOOT_INTERVAL_MS  10000\n\n#define FRAME_HEADER1   0xAA\n#define FRAME_HEADER2   0x55\n#define FRAME_FOOTER1   0x55\n#define FRAME_FOOTER2   0xAA\n\n#define FRAME_TYPE_STREAM  0x01\n#define FRAME_TYPE_PHOTO   0x02\n\n#define STREAM_FRAMESIZE  FRAMESIZE_VGA\n#define STREAM_QUALITY    12\n\n#define PHOTO_FRAMESIZE   FRAMESIZE_UXGA\n#define PHOTO_QUALITY     8\n\n\n// ========== CRC16-CCITT ==========\nstatic uint16_t crc16_ccitt(const uint8_t *data, size_t len) {\n    uint16_t crc = 0xFFFF;\n    for (size_t i = 0; i < len; i++) {\n        crc ^= data[i];\n        for (int j = 0; j < 8; j++) {\n            if (crc & 1) crc = (crc >> 1) ^ 0x8408;\n            else crc >>= 1;\n        }\n    }\n    return crc ^ 0xFFFF;\n}\n\n\n// ========== 初始化摄像头 ==========\nstatic bool initCamera() {\n    camera_config_t config{};\n    config.ledc_channel    = LEDC_CHANNEL_0;\n    config.ledc_timer      = LEDC_TIMER_0;\n    config.pin_d0          = Y2_GPIO_NUM;\n    config.pin_d1          = Y3_GPIO_NUM;\n    config.pin_d2          = Y4_GPIO_NUM;\n    config.pin_d3          = Y5_GPIO_NUM;\n    config.pin_d4          = Y6_GPIO_NUM;\n    config.pin_d5          = Y7_GPIO_NUM;\n    config.pin_d6          = Y8_GPIO_NUM;\n    config.pin_d7          = Y9_GPIO_NUM;\n    config.pin_xclk        = XCLK_GPIO_NUM;\n    config.pin_pclk        = PCLK_GPIO_NUM;\n    config.pin_vsync       = VSYNC_GPIO_NUM;\n    config.pin_href        = HREF_GPIO_NUM;\n    config.pin_sscb_sda    = SIOD_GPIO_NUM;\n    config.pin_sscb_scl    = SIOC_GPIO_NUM;\n    config.pin_pwdn        = PWDN_GPIO_NUM;\n    config.pin_reset       = RESET_GPIO_NUM;\n    config.xclk_freq_hz    = 20000000;\n    config.pixel_format    = PIXFORMAT_JPEG;\n    config.frame_size      = STREAM_FRAMESIZE;\n    config.jpeg_quality    = STREAM_QUALITY;\n    config.fb_count        = 2;\n    config.grab_mode       = CAMERA_GRAB_LATEST;\n\n    esp_err_t err = esp_camera_init(&config);\n    if (err != ESP_OK) {\n        Serial.printf(\"摄像头初始化失败: 0x%x\\n\", err);\n        return false;\n    }\n    return true;\n}\n\n\n// ========== 发送帧 (含 CRC16) ==========\nstatic void sendFrame(uint8_t type, const uint8_t *data, size_t len) {\n    if (len < 2 || len > 200 * 1024) return;\n\n    uint16_t crc = crc16_ccitt(data, len);\n\n    Serial.write(FRAME_HEADER1);\n    Serial.write(FRAME_HEADER2);\n    Serial.write(type);\n    Serial.write((uint8_t)( len        & 0xFF));\n    Serial.write((uint8_t)((len >> 8)  & 0xFF));\n    Serial.write((uint8_t)((len >> 16) & 0xFF));\n    Serial.write((uint8_t)((len >> 24) & 0xFF));\n    Serial.write((uint8_t)( crc       & 0xFF));\n    Serial.write((uint8_t)((crc >> 8) & 0xFF));\n\n    size_t sent = 0;\n    while (sent < len) {\n        size_t chunk = (len - sent > 512) ? 512 : (len - sent);\n        Serial.write(data + sent, chunk);\n        sent += chunk;\n    }\n\n    Serial.write(FRAME_FOOTER1);\n    Serial.write(FRAME_FOOTER2);\n    Serial.write(FRAME_FOOTER1);\n    Serial.write(FRAME_FOOTER2);\n}\n\n\n// ========== 拍照 + 串口发送 ==========\nstatic void shootAndSend(uint8_t type) {\n    camera_fb_t *fb = esp_camera_fb_get();\n    if (!fb) {\n        Serial.println(\"❌ 拍照失败\");\n        return;\n    }\n    sendFrame(type, fb->buf, fb->len);\n    esp_camera_fb_return(fb);\n}\n\n\n// ========== 启动 ==========\nvoid setup() {\n    Serial.begin(SERIAL_BAUD);\n    delay(500);\n    Serial.println(\"\\n\\n=== 智能灯杆 (旧版, 独立测试) ===\");\n\n    pinMode(POWER_N, OUTPUT);\n    digitalWrite(POWER_N, LOW);\n    delay(200);\n\n    if (!initCamera()) {\n        delay(10000);\n        ESP.restart();\n    }\n\n    // 首次拍照\n    shootAndSend(FRAME_TYPE_STREAM);\n}\n\nvoid loop() {\n    while (Serial.available()) {\n        char c = Serial.read();\n        if (c == 'S') {\n            shootAndSend(FRAME_TYPE_PHOTO);\n        }\n    }\n\n    static unsigned long lastShoot = 0;\n    if (millis() - lastShoot >= SHOOT_INTERVAL_MS) {\n        lastShoot = millis();\n        shootAndSend(FRAME_TYPE_STREAM);\n    }\n}", "filePath": "C:\\\\Users\\\\flxd\\\\Desktop\\\\工作文件\\\\25物联网大赛项目\\\\arduino_stream\\\\smart_lamp_post\\\\smart_lamp_post.ino"}