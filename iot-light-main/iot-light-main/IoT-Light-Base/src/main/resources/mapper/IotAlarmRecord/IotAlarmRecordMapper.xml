<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iot.mapper.IotAlarmRecordMapper">

    <resultMap type="IotAlarmRecord" id="IotAlarmRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="poleId"    column="pole_id"    />
        <result property="ruleId"    column="rule_id"    />
        <result property="paramType"    column="param_type"    />
        <result property="alarmValue"    column="alarm_value"    />
        <result property="alarmMessage"    column="alarm_message"    />
        <result property="status"    column="status"    />
        <result property="handleBy"    column="handle_by"    />
        <result property="handleTime"    column="handle_time"    />
        <result property="handleRemark"    column="handle_remark"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectIotAlarmRecordVo">
        select record_id, pole_id, rule_id, param_type, alarm_value, alarm_message, status, handle_by, handle_time, handle_remark, del_flag, create_by, create_time from iot_alarm_record
    </sql>

    <select id="selectIotAlarmRecordList" parameterType="IotAlarmRecord" resultMap="IotAlarmRecordResult">
        <include refid="selectIotAlarmRecordVo"/>
        <where>
            <if test="poleId != null "> and pole_id = #{poleId}</if>
            <if test="ruleId != null "> and rule_id = #{ruleId}</if>
            <if test="paramType != null  and paramType != ''"> and param_type = #{paramType}</if>
            <if test="alarmValue != null  and alarmValue != ''"> and alarm_value = #{alarmValue}</if>
            <if test="alarmMessage != null  and alarmMessage != ''"> and alarm_message = #{alarmMessage}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="handleBy != null  and handleBy != ''"> and handle_by = #{handleBy}</if>
            <if test="handleTime != null "> and handle_time = #{handleTime}</if>
            <if test="handleRemark != null  and handleRemark != ''"> and handle_remark = #{handleRemark}</if>
        </where>
    </select>

    <select id="selectIotAlarmRecordByRecordId" parameterType="Long" resultMap="IotAlarmRecordResult">
        <include refid="selectIotAlarmRecordVo"/>
        where record_id = #{recordId}
    </select>

    <insert id="insertIotAlarmRecord" parameterType="IotAlarmRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into iot_alarm_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="poleId != null">pole_id,</if>
            <if test="ruleId != null">rule_id,</if>
            <if test="paramType != null and paramType != ''">param_type,</if>
            <if test="alarmValue != null">alarm_value,</if>
            <if test="alarmMessage != null">alarm_message,</if>
            <if test="status != null">status,</if>
            <if test="handleBy != null">handle_by,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="handleRemark != null">handle_remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="poleId != null">#{poleId},</if>
            <if test="ruleId != null">#{ruleId},</if>
            <if test="paramType != null and paramType != ''">#{paramType},</if>
            <if test="alarmValue != null">#{alarmValue},</if>
            <if test="alarmMessage != null">#{alarmMessage},</if>
            <if test="status != null">#{status},</if>
            <if test="handleBy != null">#{handleBy},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="handleRemark != null">#{handleRemark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateIotAlarmRecord" parameterType="IotAlarmRecord">
        update iot_alarm_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="poleId != null">pole_id = #{poleId},</if>
            <if test="ruleId != null">rule_id = #{ruleId},</if>
            <if test="paramType != null and paramType != ''">param_type = #{paramType},</if>
            <if test="alarmValue != null">alarm_value = #{alarmValue},</if>
            <if test="alarmMessage != null">alarm_message = #{alarmMessage},</if>
            <if test="status != null">status = #{status},</if>
            <if test="handleBy != null">handle_by = #{handleBy},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="handleRemark != null">handle_remark = #{handleRemark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteIotAlarmRecordByRecordId" parameterType="Long">
        delete from iot_alarm_record where record_id = #{recordId}
    </delete>

    <delete id="deleteIotAlarmRecordByRecordIds" parameterType="String">
        delete from iot_alarm_record where record_id in
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

</mapper>
